# ─── How to use ──────────────────────────────────────────────────────────────
# 1. Copy this file:
#      cp .env.local.example .env.local
#
# 2. Fill in the values below.
#
# 3. Never commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-4o if not set.
# OPENAI_MODEL=gpt-4o
